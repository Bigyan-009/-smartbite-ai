# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=smartbite_ai

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# ChromaDB
CHROMA_PATH=./chroma_db

# App
APP_NAME=SmartBite AI
APP_ENV=development
ADMIN_EMAIL=admin@smartbite.ai
ADMIN_PASSWORD=admin12345

# Location & weather (weather/season/time-aware recommendations)
# Uses the free, keyless Open-Meteo API. Set WEATHER_ENABLED=false to disable.
APP_CITY=Kathmandu
APP_LAT=27.7172
APP_LON=85.3240
WEATHER_ENABLED=true

# Persistent login (days a browser session stays logged in across refresh)
SESSION_TTL_DAYS=7

# Email for password-reset codes (Gmail SMTP).
# Gmail needs an App Password, NOT your normal password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16-character code below (spaces are fine to remove).
# Leave these blank in development: the reset code is then shown on screen.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address_here
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_NAME=SmartBite AI
RESET_CODE_TTL_MINUTES=15
